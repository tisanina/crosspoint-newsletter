# ============================================================
# CrossPoint Newsletter — Environment Variables
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to Git — it is excluded via .gitignore.
# ============================================================

# --- Timezone & Localization ---
TZ=Europe/Rome
CN_TIMEZONE=Europe/Rome

# --- IMAP (email ingestion) ---
CN_IMAP_HOST=imap.example.com
CN_IMAP_PORT=993
CN_IMAP_USER=newsletters@example.com
CN_IMAP_PASSWORD=changeme
CN_IMAP_FOLDER=INBOX

# --- Data storage & Raw archiving ---
CN_DATA_DIR=./data
CN_KEEP_RAW=true              # Set to false to discard raw emails after conversion

# --- Calibre-Web integration ---
CN_CALIBRE_DB_PATH=/path/to/calibre/metadata.db
CN_CALIBRE_WEB_URL=http://your-server:8083

# --- OPDS server ---
CN_OPDS_HOST=0.0.0.0
CN_OPDS_PORT=8400
CN_OPDS_USERNAME=reader
CN_OPDS_PASSWORD=changeme

# --- Newsletter config file ---
CN_NEWSLETTERS_CONFIG=./config/newsletters.yaml
