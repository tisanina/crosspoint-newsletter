# ==============================================================================
# CrossPoint Newsletter Server — Configurazione Produzione (Unraid Tower)
# Copia questo file in .env.prod prima del deploy: cp .env.prod.example .env.prod
# NOTA: Non inserire o committare mai .env.prod nel repository Git.
# ==============================================================================

# --- Mappatura Porte Host Unraid ---
# Porta principale per WebUI e feed OPDS (default consigliato: 8400)
HOST_PORT=8400
# Porta secondaria opzionale per retrocompatibilità e-reader (default consigliato: 8080)
HOST_OPDS_PORT=8080

# --- Lingua Interfaccia e Fuso Orario ---
CN_LANGUAGE=it
CN_TIMEZONE=Europe/Rome

# --- Volumi Unraid (Cache vs RAID) ---
# Volume 1: Cache SSD (Appdata: DB SQLite, configurazioni, stato)
UNRAID_CONF_DIR=/mnt/user/appdata/crosspoint-newsletter
# Volume 2: Array RAID (Data: archivio EPUB, raw email .eml, copertine)
UNRAID_DATA_DIR=/mnt/user/data/crosspoint-newsletter

# --- Auto-Polling IMAP Periodico ---
# Abilita il controllo automatico della posta in background
CN_ENABLE_AUTO_POLL=true
# Intervallo in minuti tra un controllo e l'altro (default: ogni 15 minuti)
CN_POLL_INTERVAL_MINUTES=15

# --- Credenziali IMAP ---
CN_IMAP_HOST=imap.gmail.com
CN_IMAP_PORT=993
CN_IMAP_USER=tua-email@gmail.com
CN_IMAP_PASSWORD=tua-app-password-senza-spazi
CN_IMAP_FOLDER=INBOX

# --- Conservazione Email Originali ---
# Se true, salva le email originali (.eml) nel volume RAID data/raw/
CN_KEEP_RAW=true

# --- Autenticazione OPDS E-Reader (Opzionale) ---
# Lascia vuoto per accesso libero in rete locale senza credenziali
CN_OPDS_USERNAME=
CN_OPDS_PASSWORD=
